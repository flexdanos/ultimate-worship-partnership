# =============================================================================
# DATABASE (Supabase Postgres via Drizzle + postgres-js)
#
# Supabase gives you two connection strings — use each for a different purpose:
#
# 1. DATABASE_URL — Transaction pooler (port 6543)
#    → Used by the Next.js app at runtime (serverless-safe, prepare:false)
#    → Dashboard: Project Settings → Database → Connection pooling → Transaction
#
# 2. DIRECT_URL — Direct connection (port 5432)
#    → Used by drizzle-kit for migrations (needs a persistent connection)
#    → Dashboard: Project Settings → Database → Connection string → URI
#
# Format: postgresql://postgres.[project-ref]:[password]@[host]:[port]/postgres
# =============================================================================
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# =============================================================================
# SUPABASE
# Found in: Supabase Dashboard → Project Settings → API
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service role key — NEVER expose this to the client. Server-side only.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# =============================================================================
# STRIPE
# Found in: Stripe Dashboard → Developers → API keys
# =============================================================================
STRIPE_SECRET_KEY="sk_live_..."          # Use sk_test_... for development
STRIPE_PUBLISHABLE_KEY="pk_live_..."     # Use pk_test_... for development

# Webhook signing secret — from Stripe Dashboard → Webhooks → your endpoint
# For local dev: use `stripe listen --forward-to localhost:3000/payment-webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# =============================================================================
# STRIPE PRICE IDs
# Create these in Stripe Dashboard → Products → Add product
# One product per tier, with monthly and yearly prices each.
# =============================================================================

# Friend of Worship
STRIPE_PRICE_FRIEND_MONTHLY="price_..."
STRIPE_PRICE_FRIEND_YEARLY="price_..."

# Worship Partner
STRIPE_PRICE_WORSHIP_MONTHLY="price_..."
STRIPE_PRICE_WORSHIP_YEARLY="price_..."

# Altar Builder
STRIPE_PRICE_ALTAR_MONTHLY="price_..."
STRIPE_PRICE_ALTAR_YEARLY="price_..."

# =============================================================================
# APP
# Base URL used for Stripe success/cancel redirect URLs.
# In production this is your deployed domain.
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
